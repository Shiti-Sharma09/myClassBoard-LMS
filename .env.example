# Copy this file to `.env` and fill in the blanks. `.env` is git-ignored.

# --- AI provider (Groq free tier) ---
GROQ_API_KEY=
# Model names are config, not code. Check https://console.groq.com for what your key can use.
# Main model: questions, summaries, reports
LLM_MODEL_MAIN=openai/gpt-oss-120b
# Fast model: interview turns (lower latency)
LLM_MODEL_FAST=openai/gpt-oss-20b
# Vision model: handwriting OCR (must accept images)
VISION_MODEL=qwen/qwen3.8-27b

# --- App ---
DATABASE_URL=postgresql+psycopg://lms:lms@db:5432/lms
JWT_SECRET=dev-only-secret-change-me-before-any-real-use
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/app/uploads

# --- Ports on your machine (change if something else already uses them) ---
BACKEND_PORT=8010
FRONTEND_PORT=3000

# --- Frontend, only when running `npm run dev:local` outside Docker ---
NEXT_PUBLIC_API_URL=http://localhost:8010
